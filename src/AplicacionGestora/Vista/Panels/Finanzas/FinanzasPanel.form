<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="AplicacionGestora.Vista.Panels.Finanzas.FinanzasPanel">
  <grid id="finanzas" binding="panelRaiz" layout-manager="GridLayoutManager" row-count="4" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="28" left="36" bottom="28" right="36"/>
    <constraints>
      <xy x="20" y="20" width="700" height="500"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="titulo" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="FINANZAS"/>
        </properties>
      </component>
      <component id="periodo" class="javax.swing.JComboBox" binding="cmbPeriodo">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="fecha" class="javax.swing.JTextField" binding="txtFecha">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="consultar" class="javax.swing.JButton" binding="btnConsultar">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Consultar"/>
        </properties>
      </component>
      <scrollpane id="tablaScroll">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="3" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="tabla" class="javax.swing.JTable" binding="tablaIngresos">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <component id="total" class="javax.swing.JLabel" binding="lblTotal">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="volver" class="javax.swing.JButton" binding="btnVolver">
        <constraints>
          <grid row="3" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Volver"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
